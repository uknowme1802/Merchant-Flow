# ---- Required ----
PORT=5000
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/merchantflow
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT values, at least 32 characters each.
SECRET=
REFRESH_SECRET=

# ---- Recommended in production ----
NODE_ENV=production
REDIS_URL=rediss://default:password@host:6379
# Comma-separated list of frontend origins allowed by CORS and Socket.IO
ALLOWED_ORIGINS=https://merchant-flow-one.vercel.app
# Number of reverse proxies in front of the API (Render = 1). Needed for correct client IPs / rate limiting.
TRUST_PROXY=1
# If set, GET /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=
# Payee shown in checkout QR codes
UPI_ID=
UPI_NAME=MerchantFlow

# ---- Optional ----
LOG_LEVEL=info                   # error | warn | info | debug
WEBHOOK_TIMEOUT_MS=5000          # outbound webhook timeout
WEBHOOK_MAX_ATTEMPTS=5           # first send + retries
WEBHOOK_RETRY_INTERVAL_MS=30000  # retry worker interval
WEBHOOK_LOG_RETENTION_DAYS=30    # delivery logs are deleted after this

# ---- Only for scripts/seedAdmin.js ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Merchant platform (Phase 1)
# 64 hex characters (32 bytes) used to encrypt merchant secret keys at rest.
# Generate with: openssl rand -hex 32   -- keep it out of the database and out of git.
CREDENTIAL_ENC_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
# Hours an old secret keeps working after a rotation (default 24)
CREDENTIAL_ROTATION_GRACE_HOURS=24
# Requests per minute allowed per MID on /v1 (default 300)
MERCHANT_API_RATE_LIMIT=300
